[core]
  excludesfile = ~/.gitignore
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  syntax-theme = base16-256
[merge]
  conflictStyle = zdiff3
[user]
	name = jps
	email = jpsalo@zoho.com
[merge "ours"]
	driver = true
[filter "ignoreColor"]
  # https://github.com/tinted-theming/tinted-shell/blob/main/scripts/base16-default-dark.sh
  # https://github.com/stacyharper/base16-i3status/blob/master/colors/base16-default-dark.config
  clean = sed -e '/color_good /s/=.*$/= \""#a1b56c"\"/' -e '/color_bad /s/=.*$/= \""#ab4642"\"/'
  smudge = cat
[pager]
  branch = false
